{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "混剪素材整理助手",
  "version": "0.1.0",
  "identifier": "com.localvideolibrary.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "混剪素材整理助手",
        "width": 1380,
        "height": 900,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; media-src 'self' blob: asset: http://asset.localhost https://asset.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'; style-src 'self' 'unsafe-inline'",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": false,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
